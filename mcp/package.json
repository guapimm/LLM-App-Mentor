{
  "name": "mentor-mcp",
  "version": "0.1.0",
  "description": "AI Model Mentor MCP server - on-demand policy fragments and sandboxed workspace tools",
  "type": "module",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "coding-assistant",
    "mentor",
    "sandbox",
    "prompt-engineering"
  ],
  "homepage": "https://github.com/guapimm/AI-Model-Development-Mentor/tree/main/mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guapimm/AI-Model-Development-Mentor.git",
    "directory": "mcp"
  },
  "bugs": {
    "url": "https://github.com/guapimm/AI-Model-Development-Mentor/issues"
  },
  "bin": {
    "mentor-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "policy",
    "prompts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc -p tsconfig.test.json && node --test dist/*.test.js",
    "sync": "node scripts/sync.mjs",
    "prepack": "node scripts/sync.mjs && node --input-type=module -e \"import fs from 'node:fs'; fs.rmSync('dist',{recursive:true,force:true})\" && tsc"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
